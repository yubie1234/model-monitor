{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "model-monitor /metrics 를 스크레이프하는 Prometheus 데이터소스",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "piechart", "name": "Pie chart", "version": ""},
    {"type": "panel", "id": "bargauge", "name": "Bar gauge", "version": ""},
    {"type": "panel", "id": "state-timeline", "name": "State timeline", "version": ""}
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "알럿 발생 (firing)",
        "expr": "ALERTS{alertname=~\"Model.*|Backend.*\", alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{model}} {{namespace}}/{{service}}",
        "tagKeys": "alertname,severity,model",
        "step": "30s"
      }
    ]
  },
  "description": "LiteLLM -> KServe -> vLLM/SGLang 모델 서빙 현황과 LB 뒤 backend Pod/GPU 수. model-monitor /metrics 기반. PrometheusRule 알럿을 그래프에 오버레이.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["llm", "litellm", "kserve", "model-monitor"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {"text": ["All"], "value": ["$__all"]},
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "definition": "label_values(model_monitor_model_up, namespace)",
        "hide": 0,
        "includeAll": true,
        "label": "Namespace",
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": {"query": "label_values(model_monitor_model_up, namespace)", "refId": "ns"},
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {"text": ["All"], "value": ["$__all"]},
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "definition": "label_values(model_monitor_model_up{namespace=~\"$namespace\"}, model)",
        "hide": 0,
        "includeAll": true,
        "label": "Model",
        "multi": true,
        "name": "model",
        "options": [],
        "query": {"query": "label_values(model_monitor_model_up{namespace=~\"$namespace\"}, model)", "refId": "model"},
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "LLM Model Monitor",
  "uid": "llm-model-monitor",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "title": "개요 (Overview)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "모델 UP",
      "description": "상태 UP 인 deployment 수 (model_monitor_deployments_healthy). max() 로 다중 인스턴스(롤링/HA) 이중 집계를 방지.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "green"}, "unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_deployments_healthy)", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "모델 DOWN",
      "description": "상태 DOWN 인 deployment 수. 0 초과면 빨강.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "id": 2,
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_deployments_unhealthy)", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "총 모델",
      "description": "집계된 deployment(모델) 총 수.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "id": 3,
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "text"}, "unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_deployments_total)", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "모델 그룹",
      "description": "LiteLLM 모델 그룹 수 (model_monitor_model_groups).",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 3, "x": 12, "y": 1},
      "id": 13,
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "text"}, "unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_model_groups)", "refId": "A"}
      ]
    },
    {
      "type": "gauge",
      "title": "Backend Pod 가용률",
      "description": "ready / desired Pod 비율(공유 Service 1회 집계). backend_pods_known==0(카운팅 꺼짐/RBAC 부족)이면 0% 가 아니라 'N/A' 로 표시해 오독을 막는다. 80% 미만 주황, 50% 미만 빨강.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 15, "y": 1},
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1, "unit": "percentunit", "noValue": "N/A (미상)",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "orange", "value": 0.5},
            {"color": "green", "value": 0.8}
          ]}
        },
        "overrides": []
      },
      "options": {"showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "(max(model_monitor_backend_pods_ready_total) / clamp_min(max(model_monitor_backend_pods_desired_total), 1)) and on() (max(model_monitor_backend_pods_known) == 1)", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "Backend Pods (ready/desired)",
      "description": "모든 LB 뒤 ready / desired Pod 합계.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 1},
      "id": 5,
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "blue"}, "unit": "short"}, "overrides": [
        {"matcher": {"id": "byName", "options": "desired"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "text"}}]}
      ]},
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_backend_pods_ready_total)", "legendFormat": "ready", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_backend_pods_desired_total)", "legendFormat": "desired", "refId": "B"}
      ]
    },
    {
      "type": "row",
      "title": "GPU",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 103,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "모니터 버전",
      "description": "model_monitor_build_info 의 version 라벨. 실행 중인 model-monitor 이미지 버전.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 6},
      "id": 20,
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "purple"}, "unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_build_info) by (version)", "legendFormat": "{{version}}", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "GPU 총 점유",
      "description": "모든 backend ready Pod 가 점유한 GPU 합계(공유 Service dedup). gpus_known==0 이면 'N/A'.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 4, "x": 4, "y": 6},
      "id": 21,
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "green"}, "unit": "short", "noValue": "N/A"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_backend_gpus_ready_total) and on() (max(model_monitor_backend_gpus_known) == 1)", "refId": "A"}
      ]
    },
    {
      "type": "piechart",
      "title": "장치별 GPU (device)",
      "description": "장치 모델(H100/B200 등)별 ready GPU 합계. 이기종 GPU 구성을 한눈에.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 6},
      "id": 22,
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}, "overrides": []},
      "options": {
        "pieType": "donut",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "legend": {"displayMode": "list", "placement": "right", "showLegend": true, "values": ["value"]},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "model_monitor_backend_gpus_ready_by_device", "legendFormat": "{{device}}", "instant": true, "refId": "A"}
      ]
    },
    {
      "type": "bargauge",
      "title": "모델별 GPU 점유",
      "description": "모델(=서빙 Service)별 ready GPU 수. 공유 Service 는 여러 모델에 같은 물리 GPU 가 잡히므로 합산이 아닌 개별 값으로 본다(총합은 상단 'GPU 총 점유').",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 6},
      "id": 23,
      "fieldConfig": {"defaults": {"color": {"mode": "continuous-GrYlRd"}, "unit": "short", "min": 0}, "overrides": []},
      "options": {"displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max by (model, namespace, service) (model_monitor_model_backend_gpus_ready{namespace=~\"$namespace\", model=~\"$model\"}) > 0", "legendFormat": "{{model}} ({{service}})", "instant": true, "refId": "A"}
      ]
    },
    {
      "type": "row",
      "title": "이상 징후 (Anomalies)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12},
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "진짜 DOWN (idle 제외)",
      "description": "model_up==0 이면서 scale_to_zero==0 인 모델 수. scale-to-zero 정상 idle 을 오탐하지 않는다 — 이 모니터만 아는 구분.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 13},
      "id": 6,
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short", "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "count((max by (model, namespace, service) (model_monitor_model_up) == 0) and on(model) (max by (model) (model_monitor_model_scale_to_zero) == 0)) or vector(0)", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "LB UP인데 Pod 0",
      "description": "model_up==1 인데 ready Pod 가 0 인 모델 수. LiteLLM /health 는 LB 만 찌르니 'UP'으로 보이는 함정 — 이 모니터의 고유 가치.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 13},
      "id": 7,
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}, "unit": "short", "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "count((max by (model, namespace, service) (model_monitor_model_up) == 1) and on(model) (max by (model) (model_monitor_model_scale_to_zero) == 0) and on(model, namespace, service) (max by (model, namespace, service) (model_monitor_model_backend_pods_ready) == 0)) or vector(0)", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "수집 신뢰도",
      "description": "monitor up(모니터 응답) / collect errors(k8s 조회 에러 수) / pods known(Pod 카운팅 성공) / backend count(카운팅 기능 on). pods known=no 나 backend count=off 면 상단 ready/desired·가용률이 '미상'이지 장애가 아님.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 13},
      "id": 8,
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short"},
        "overrides": [
          {"matcher": {"id": "byName", "options": "monitor up"}, "properties": [
            {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}},
            {"id": "mappings", "value": [{"type": "value", "options": {"1": {"text": "OK"}, "0": {"text": "DOWN"}}}]}
          ]},
          {"matcher": {"id": "byName", "options": "pods known"}, "properties": [
            {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "orange", "value": null}, {"color": "green", "value": 1}]}},
            {"id": "mappings", "value": [{"type": "value", "options": {"1": {"text": "yes"}, "0": {"text": "no"}}}]}
          ]},
          {"matcher": {"id": "byName", "options": "backend count"}, "properties": [
            {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "orange", "value": null}, {"color": "green", "value": 1}]}},
            {"id": "mappings", "value": [{"type": "value", "options": {"1": {"text": "on"}, "0": {"text": "off"}}}]}
          ]}
        ]
      },
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_up)", "legendFormat": "monitor up", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_collect_errors)", "legendFormat": "collect errors", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_backend_pods_known)", "legendFormat": "pods known", "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_backend_count_enabled)", "legendFormat": "backend count", "refId": "D"}
      ]
    },
    {
      "type": "row",
      "title": "추세 · 상세 (Trends)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "id": 102,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "모델 상태 추세 (UP / DOWN)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 19},
      "id": 9,
      "fieldConfig": {
        "defaults": {"custom": {"drawStyle": "line", "fillOpacity": 20, "stacking": {"mode": "normal", "group": "A"}, "lineWidth": 1}, "unit": "short"},
        "overrides": [
          {"matcher": {"id": "byName", "options": "UP"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byName", "options": "DOWN"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_deployments_healthy)", "legendFormat": "UP", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_deployments_unhealthy)", "legendFormat": "DOWN", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Backend Pod 추세 (ready vs desired)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 19},
      "id": 10,
      "fieldConfig": {
        "defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}, "unit": "short"},
        "overrides": [
          {"matcher": {"id": "byName", "options": "ready"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
          {"matcher": {"id": "byName", "options": "desired"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "text"}}, {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}}]}
        ]
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_backend_pods_ready_total)", "legendFormat": "ready", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "max(model_monitor_backend_pods_desired_total)", "legendFormat": "desired", "refId": "B"}
      ]
    },
    {
      "type": "bargauge",
      "title": "모델별 ready Pod",
      "description": "모델(=서빙 Service)별 ready backend Pod 수 — 어디에 용량이 몰려 있는지 시각화. 공유 Service 는 개별 값(합산 아님).",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 27},
      "id": 24,
      "fieldConfig": {"defaults": {"color": {"mode": "continuous-BlPu"}, "unit": "short", "min": 0}, "overrides": []},
